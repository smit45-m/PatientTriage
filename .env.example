# ── PatientTriage.ai — Environment Variables ────────────────────────────────
# Copy this file to .env and update values for your environment.

# JWT Secret Key — CHANGE THIS for production deployments
JWT_SECRET_KEY=patient_triage_super_secret_hackathon_key_2026

# CORS Allowed Origins — comma-separated list (use * for dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Local LLM endpoint for RAG agent neural synthesis
# Requires Ollama with BioMistral or Llama 3 model pulled locally
# OLLAMA_URL=http://localhost:11434

# Frontend API URL (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
